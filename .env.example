# ── LLM ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Discovery ─────────────────────────────────────────────────────────────
EXA_API_KEY=your-exa-key-here

# ── PostgreSQL ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=aiagent
DB_PASSWORD=aiagent_secret
DB_NAME=autonomous_ai

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Cadence (minutes; set TEST_MODE=true to use seconds instead) ──────────
CADENCE_MIN=20
CADENCE_MAX=45
CADENCE_JITTER=5
TEST_MODE=false

# ── Editorial scoring ─────────────────────────────────────────────────────
SCORE_THRESHOLD=0.6
RELEVANCE_THRESHOLD=0.5

# ── Post length ───────────────────────────────────────────────────────────
POST_MIN_CHARS=400
POST_MAX_CHARS=1600

# ── Memory dedup ──────────────────────────────────────────────────────────
DEDUP_THRESHOLD=0.5
MEMORY_LOOKBACK=10
